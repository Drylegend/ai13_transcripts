{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1",
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "items": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "board",
              "doodle"
            ]
          },
          "dayNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "labId": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "image": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "docx",
                  "md",
                  "html",
                  "pdf",
                  "ipynb",
                  "webp",
                  "png",
                  "jpg",
                  "svg"
                ]
              },
              "sizeBytes": {
                "type": "number",
                "minimum": 0
              },
              "hash": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "format",
              "sizeBytes",
              "hash",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "thumb": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "docx",
                  "md",
                  "html",
                  "pdf",
                  "ipynb",
                  "webp",
                  "png",
                  "jpg",
                  "svg"
                ]
              },
              "sizeBytes": {
                "type": "number",
                "minimum": 0
              },
              "hash": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "format",
              "sizeBytes",
              "hash",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "addedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "image",
          "width",
          "height",
          "addedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "updatedAt",
    "items"
  ],
  "additionalProperties": false
}