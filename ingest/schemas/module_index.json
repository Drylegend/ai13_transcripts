{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1",
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "default": "",
            "type": "string"
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "courseCode": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "coverImage": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "docx",
                  "md",
                  "html",
                  "pdf",
                  "ipynb",
                  "webp",
                  "png",
                  "jpg",
                  "svg"
                ]
              },
              "sizeBytes": {
                "type": "number",
                "minimum": 0
              },
              "hash": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "format",
              "sizeBytes",
              "hash",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "dayCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "labCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "boardCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "questionCount": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transcriptCount": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "slug",
          "title",
          "subtitle",
          "description",
          "order",
          "dayCount",
          "labCount",
          "boardCount",
          "questionCount",
          "transcriptCount",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "updatedAt",
    "modules"
  ],
  "additionalProperties": false
}