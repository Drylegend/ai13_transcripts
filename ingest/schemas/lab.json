{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "docx",
            "md",
            "html",
            "pdf",
            "ipynb",
            "webp",
            "png",
            "jpg",
            "svg"
          ]
        },
        "sizeBytes": {
          "type": "number",
          "minimum": 0
        },
        "hash": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "format",
        "sizeBytes",
        "hash",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "doodle": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "docx",
            "md",
            "html",
            "pdf",
            "ipynb",
            "webp",
            "png",
            "jpg",
            "svg"
          ]
        },
        "sizeBytes": {
          "type": "number",
          "minimum": 0
        },
        "hash": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "format",
        "sizeBytes",
        "hash",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "thumb": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "docx",
            "md",
            "html",
            "pdf",
            "ipynb",
            "webp",
            "png",
            "jpg",
            "svg"
          ]
        },
        "sizeBytes": {
          "type": "number",
          "minimum": 0
        },
        "hash": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "format",
        "sizeBytes",
        "hash",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "number",
    "category",
    "title",
    "updatedAt"
  ],
  "additionalProperties": false
}