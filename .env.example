# Storage Target: site (default, zero-card, stored in public/content) | local (sandbox dev-content) | r2 (cloud bucket)
INGEST_TARGET=site

# Optional Cloudflare R2 Credentials (only needed if INGEST_TARGET=r2 or --target r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional: Override content base URL in frontend (only needed for R2 mode)
# VITE_CONTENT_BASE_URL=https://your-bucket.r2.dev
