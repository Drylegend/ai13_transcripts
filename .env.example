# Cloudflare R2 Credentials (for --target r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=ai13-course-notes

# Target storage backend (r2 | local, defaults to r2)
INGEST_TARGET=r2

# Local storage root directory (when target is local)
LOCAL_CONTENT_ROOT=./dev-content
